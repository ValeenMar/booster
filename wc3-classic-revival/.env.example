# ============================================================================
# wc3-classic-revival — variables de entorno
# Copiar a .env y completar. .env NUNCA se commitea (esta en .gitignore).
# Todas las variables usadas por los templates empiezan con WC3_ — el script
# de render usa ese prefijo como whitelist para envsubst.
# ============================================================================

# --- Red / identidad del servidor -------------------------------------------
# IP publica del VPS. Critica: se anuncia a los clientes en el protocolo
# (address_translation del w3route). NO usar hostname, solo IP.
WC3_PUBLIC_IP=203.0.113.10

# Puerto de PvPGN (el clasico de Battle.net es 6112; no hay motivo para cambiarlo)
WC3_PVPGN_PORT=6112

# Nombre del realm que ven los clientes y el bot
WC3_REALM_NAME="WC3 Revival"

WC3_SERVER_LOCATION=Sudamerica
WC3_SERVER_DESCRIPTION="Servidor privado de W3 TFT 1.26a - mapas clasicos"
WC3_SERVER_URL=https://example.invalid
WC3_CONTACT_NAME=admin
WC3_CONTACT_EMAIL=admin@example.invalid

# --- Version del juego -------------------------------------------------------
# 26 = 1.26a (por defecto). Para migrar a 1.28.5 cambiar a 28 y releer
# docs/version-1.26a.md (seccion "cambiar de version").
WC3_WAR3_VERSION=26

# --- Rutas en el VPS ---------------------------------------------------------
WC3_ROOT=/opt/wc3
WC3_MAPS_DIR=/opt/wc3/maps
WC3_MPQ_DIR=/opt/wc3/mpq
WC3_HOSTBOT_DIR=/opt/wc3/hostbot

# --- Base de datos (PvPGN sobre MySQL) --------------------------------------
WC3_DB_HOST=127.0.0.1
WC3_DB_NAME=pvpgn
WC3_DB_USER=pvpgn
# Generar con: openssl rand -base64 24
WC3_DB_PASS=CAMBIAME

# Password de root de MySQL solo si el socket unix no alcanza (normalmente
# no hace falta: 30-setup-mysql.sh usa sudo + auth_socket).
# WC3_DB_ROOT_PASS=

# --- Hostbots ----------------------------------------------------------------
# Rango de puertos TCP a abrir en ufw para las instancias (hostport y
# reconnectport de cada instance-N.env tienen que caer adentro).
WC3_BOT_PORT_RANGE=6113:6140

# Cuenta que el bot usa para loguearse al PvPGN (crearla en fase 1)
WC3_BOT_USERNAME=hostbot
WC3_BOT_PASSWORD=CAMBIAME

# Admins del bot: cuentas PvPGN separadas por espacio
WC3_BOT_ROOTADMINS=admin

# Velocidad combinada de descarga de mapas in-lobby, en KB/s
WC3_BOT_MAXDLSPEED=500

# Defaults que cada instance-N.env normalmente pisa:
WC3_BOT_HOSTPORT=6113
WC3_BOT_RECONNECTPORT=6133
WC3_BOT_VIRTUALHOST="|cFF4080C0WC3R-Bot"
WC3_BOT_DEFAULTMAP=dota
WC3_BOT_MAXGAMES=4
WC3_BOT_CHANNEL=W3
